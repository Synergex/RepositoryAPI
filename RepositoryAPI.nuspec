<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
	<metadata>
		<id>RepositoryAPI</id>
		<version>$version$</version>
		<authors>Synergex International Corporation</authors>
		<license type="expression">BSD-2-Clause</license>
		<requireLicenseAcceptance>true</requireLicenseAcceptance>
		<description>A .NET API for accessing metadata from a Synergy Repository.</description>
		<projectUrl>https://github.com/Synergex/CodeGen</projectUrl>
		<repository type="git" url="https://github.com/Synergex/RepositoryAPI" commit="$commit$" />
		<dependencies>
			<group targetFramework="netstandard2.0">
				<dependency id="Newtonsoft.Json" version="[13.0.4,14)" />
				<dependency id="Synergex.SynergyDE.Build" version="[26.8.1692,27)" exclude="Build,BuildTransitive,Analyzers" />
				<dependency id="Synergex.SynergyDE.ddlib" version="[12.5.1.1007,13)" exclude="Build,BuildTransitive,Analyzers" />
				<dependency id="Synergex.SynergyDE.synrnt" version="[12.5.1.1007,13)" exclude="Build,BuildTransitive,Analyzers" />
				<dependency id="Synergex.SynergyDE.synxml" version="[12.5.1.1007,13)" exclude="Build,BuildTransitive,Analyzers" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="RepositoryAPI\bin\Release\netstandard2.0\RepositoryAPI.dll" target="lib\netstandard2.0\RepositoryAPI.dll" />
		<file src="RepositoryAPI\bin\Release\netstandard2.0\RepositoryAPI.pdb" target="lib\netstandard2.0\RepositoryAPI.pdb" />
		<file src="RepositoryAPI\*.dbl" target="src\RepositoryAPI\" />
		<file src="LICENSE.md" target="LICENSE.md" />
	</files>
</package>
